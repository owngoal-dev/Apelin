        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e i suoi messaggi verranno eliminati. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」とそのメッセージが削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 및 해당 메시지가 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
