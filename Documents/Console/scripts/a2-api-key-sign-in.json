{
  "name": "a2-api-key-sign-in: REPLACES, then removes, the device's openai-compatible sign-in. Signs in to an OpenAI-compatible endpoint with a placeholder key through agentSignIn and agentSignInRespond, lists it signed in under its host, signs out and lists it signed out",
  "steps": [
    {"op": "hello"},
    {"op": "agentSignIn", "label": "key", "follow": false, "request": {"provider": "openAICompatible"}},
    {"op": "agentAttach", "label": "fields", "follow": false,
     "request": {"taskID": "${key.response.taskID}", "afterSeq": 0, "waitMilliseconds": 5000}},
    {"op": "expect", "request": {"step": "fields", "path": "response.events.0.kind", "equals": "input"}},
    {"op": "agentSignInRespond", "request": {"taskID": "${key.response.taskID}", "verifyModel": false, "values": {
      "apiKey": "apelin-placeholder-key", "baseUrl": "https://llm.example.invalid/v1", "defaultModel": "placeholder-model"
    }}},
    {"op": "agentAttach", "label": "signed-in", "request": {"taskID": "${key.response.taskID}", "afterSeq": 0, "waitMilliseconds": 5000}},
    {"op": "agentAccountList", "label": "listed"},
    {"op": "expect", "request": {"step": "listed", "path": "response.accounts.26.signedIn", "equals": true}},
    {"op": "expect", "request": {"step": "listed", "path": "response.accounts.26.account", "equals": "llm.example.invalid"}},
    {"op": "agentSignOut", "request": {"provider": "openAICompatible"}},
    {"op": "agentAccountList", "label": "signed-out"},
    {"op": "expect", "request": {"step": "signed-out", "path": "response.accounts.26.signedIn", "equals": false}}
  ]
}
