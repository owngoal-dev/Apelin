    "New projects will use this toolchain. To switch an existing project’s toolchain, ask the model in that project." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستستخدم المشاريع الجديدة سلسلة الأدوات هذه. لتغيير سلسلة أدوات مشروع موجود، اطلب ذلك من النموذج داخل المشروع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Projekte verwenden diese Toolchain. Um die Toolchain eines bestehenden Projekts zu wechseln, bitte das Modell in diesem Projekt darum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los proyectos nuevos usarán esta cadena de herramientas. Para cambiar la de un proyecto existente, pídeselo al modelo en ese proyecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux projets utiliseront cette chaîne d’outils. Pour changer celle d’un projet existant, demandez-le au modèle dans ce projet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi progetti useranno questa toolchain. Per cambiarla in un progetto esistente, chiedilo al modello in quel progetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいプロジェクトはこのツールチェーンを使用します。既存のプロジェクトで切り替えるには、そのプロジェクト内でモデルに依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
