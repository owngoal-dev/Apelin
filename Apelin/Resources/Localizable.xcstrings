    "Install a toolchain and an iOS SDK before creating this project, or create a project later." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت سلسلة أدوات وiOS SDK قبل إنشاء هذا المشروع، أو أنشئ مشروعًا لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere eine Toolchain und ein iOS SDK, bevor du dieses Projekt erstellst, oder erstelle später ein Projekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install a toolchain and an iOS SDK before creating this project, or create a project later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala una cadena de herramientas y un SDK de iOS antes de crear este proyecto, o crea un proyecto más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
