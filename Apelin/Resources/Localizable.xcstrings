    "“%@” and its messages will be deleted. This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف «%@» ورسائلها. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und seine Nachrichten werden gelöscht. Das kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán “%@” y sus mensajes. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
