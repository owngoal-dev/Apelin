          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте поле пустым, чтобы пока использовать показанное название. Агент назовёт проект, когда поймёт, что вы создаёте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để trống để tạm dùng tên đang hiển thị. Tác nhân sẽ đặt tên cho dự án khi biết bạn đang làm gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
