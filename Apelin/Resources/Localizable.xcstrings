    "Pick a template to start your first project. You can also create one later from the sidebar." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر قالبًا لبدء مشروعك الأول. يمكنك أيضًا إنشاء مشروع لاحقًا من الشريط الجانبي."
          }
        },
        "de" : {
          "stringUnit" : {
