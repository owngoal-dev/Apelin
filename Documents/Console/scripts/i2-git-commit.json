{
  "name": "i2-git-commit",
  "steps": [
    {"op": "gitStatus", "request": {"projectID": "I2GitCheck"}, "label": "status"},
    {"op": "expect", "request": {"step": "status", "path": "response.entries.0.path", "equals": "i2-note.txt"}},
    {"op": "expect", "request": {"step": "status", "path": "response.entries.0.worktree", "equals": "?"}},
    {"op": "gitDiff", "request": {"projectID": "I2GitCheck", "path": "i2-note.txt"}, "label": "diff"},
    {"op": "gitStage", "request": {"projectID": "I2GitCheck", "paths": ["i2-note.txt"]}},
    {"op": "gitStatus", "request": {"projectID": "I2GitCheck"}, "label": "staged"},
    {"op": "expect", "request": {"step": "staged", "path": "response.entries.0.index", "equals": "A"}},
    {"op": "gitDiff", "request": {"projectID": "I2GitCheck", "staged": true}, "label": "staged-diff"},
    {"op": "gitCommit", "request": {"projectID": "I2GitCheck", "message": "Add a note from the console", "authorName": "Apelin Console", "authorEmail": "console@apelin.invalid"}, "label": "commit"},
    {"op": "expect", "request": {"step": "commit", "path": "response.commitID", "exists": true}},
    {"op": "gitStatus", "request": {"projectID": "I2GitCheck"}, "label": "clean"},
    {"op": "expect", "request": {"step": "clean", "path": "response.entries", "equals": []}},
    {"op": "expect", "request": {"step": "clean", "path": "response.head", "equals": "${commit.response.commitID}"}},
    {"op": "gitSquash", "request": {"projectID": "I2GitCheck", "count": 1, "preview": true}, "label": "squash-one", "allowError": true},
    {"op": "expect", "request": {"step": "squash-one", "errorCode": "conflict"}},
    {"op": "gitSquash", "request": {"projectID": "I2GitCheck", "count": 2, "base": "0000000", "preview": true}, "label": "squash-both", "allowError": true},
    {"op": "expect", "request": {"step": "squash-both", "errorCode": "badRequest"}}
  ]
}
