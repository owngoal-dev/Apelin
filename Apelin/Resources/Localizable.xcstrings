          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn một mẫu để bắt đầu dự án đầu tiên. Bạn cũng có thể tạo dự án sau từ thanh bên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
