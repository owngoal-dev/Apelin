{
  "name": "accounts: needs the network; lists every provider kwwk signs in to, in kwwk's order, starts a GitHub Copilot sign-in and reads its device code, checks a device flow takes no typed values and cancels it; starts OpenRouter's browser sign-in, reads its page, refuses an address with no code and cancels it; starts Cursor's polled sign-in, reads its page, refuses a pasted address and cancels it; refuses a method OpenRouter does not offer; starts OpenRouter's key form, reads its fields and cancels it; then starts an Anthropic API-key sign-in, checks it asks for its fields and refuses an empty key, and cancels that too. Signs nothing in or out",
  "steps": [
    {"op": "hello"},
    {"op": "agentAccountList", "label": "before"},
    {"op": "agentModelList", "label": "model-list", "allowError": true, "request": {"provider": "githubCopilot"}},
    {"op": "agentModelActivate", "label": "empty-models", "allowError": true, "follow": false, "request": {"provider": "githubCopilot", "models": []}},
    {"op": "expect", "request": {"step": "empty-models", "errorCode": "badRequest"}},
    {"op": "expect", "request": {"step": "before", "path": "response.accounts.0.provider", "equals": "openAICodex"}},
    {"op": "expect", "request": {"step": "before", "path": "response.accounts.2.provider", "equals": "githubCopilot"}},
    {"op": "expect", "request": {"step": "before", "path": "response.accounts.9.provider", "equals": "openRouter"}},
    {"op": "expect", "request": {"step": "before", "path": "response.accounts.9.alternativeMethods.0", "equals": "apiKey"}},
    {"op": "expect", "request": {"step": "before", "path": "response.accounts.22.provider", "equals": "openAICompatible"}},

    {"op": "agentSignIn", "label": "copilot", "follow": false, "request": {"provider": "githubCopilot"}},
    {"op": "expect", "request": {"step": "copilot", "path": "response.kind", "equals": "signIn"}},
    {"op": "agentAttach", "label": "code", "follow": false,
     "request": {"taskID": "${copilot.response.taskID}", "afterSeq": 0, "waitMilliseconds": 15000}},
    {"op": "expect", "request": {"step": "code", "path": "response.events.0.kind", "equals": "deviceCode"}},
    {"op": "agentSignInRespond", "label": "copilot-values", "allowError": true,
     "request": {"taskID": "${copilot.response.taskID}", "values": {"apiKey": "not-a-key"}}},
    {"op": "expect", "request": {"step": "copilot-values", "errorCode": "badRequest"}},
    {"op": "agentSignInCancel", "request": {"taskID": "${copilot.response.taskID}"}},
    {"op": "agentAttach", "label": "copilot-ended", "follow": false,
     "request": {"taskID": "${copilot.response.taskID}", "afterSeq": "${code.response.lastSeq}", "waitMilliseconds": 5000}},
    {"op": "expect", "request": {"step": "copilot-ended", "path": "response.state", "equals": "cancelled"}},

    {"op": "agentSignIn", "label": "openrouter", "follow": false, "request": {"provider": "openRouter"}},
    {"op": "agentAttach", "label": "openrouter-page", "follow": false,
     "request": {"taskID": "${openrouter.response.taskID}", "afterSeq": 0, "waitMilliseconds": 5000}},
    {"op": "expect", "request": {"step": "openrouter-page", "path": "response.events.0.kind", "equals": "authorize"}},
    {"op": "expect", "request": {"step": "openrouter-page", "path": "response.events.0.payload.acceptsCallbackURL", "equals": true}},
    {"op": "agentSignInRespond", "label": "openrouter-no-code", "allowError": true,
     "request": {"taskID": "${openrouter.response.taskID}", "values": {"callbackURL": "http://localhost:53693/?nothing=here"}}},
    {"op": "expect", "request": {"step": "openrouter-no-code", "errorCode": "badRequest"}},
    {"op": "agentSignInCancel", "request": {"taskID": "${openrouter.response.taskID}"}},
    {"op": "agentAttach", "label": "openrouter-ended", "follow": false,
     "request": {"taskID": "${openrouter.response.taskID}", "afterSeq": "${openrouter-page.response.lastSeq}", "waitMilliseconds": 5000}},
    {"op": "expect", "request": {"step": "openrouter-ended", "path": "response.state", "equals": "cancelled"}},

    {"op": "agentSignIn", "label": "cursor", "follow": false, "request": {"provider": "cursor"}},
    {"op": "agentAttach", "label": "cursor-page", "follow": false,
     "request": {"taskID": "${cursor.response.taskID}", "afterSeq": 0, "waitMilliseconds": 5000}},
    {"op": "expect", "request": {"step": "cursor-page", "path": "response.events.0.kind", "equals": "authorize"}},
    {"op": "expect", "request": {"step": "cursor-page", "path": "response.events.0.payload.acceptsCallbackURL", "equals": false}},
    {"op": "agentSignInRespond", "label": "cursor-paste", "allowError": true,
     "request": {"taskID": "${cursor.response.taskID}", "values": {"callbackURL": "http://localhost:1/?code=placeholder"}}},
    {"op": "expect", "request": {"step": "cursor-paste", "errorCode": "conflict"}},
    {"op": "agentSignInCancel", "request": {"taskID": "${cursor.response.taskID}"}},
    {"op": "agentAttach", "label": "cursor-ended", "follow": false,
     "request": {"taskID": "${cursor.response.taskID}", "afterSeq": "${cursor-page.response.lastSeq}", "waitMilliseconds": 5000}},
    {"op": "expect", "request": {"step": "cursor-ended", "path": "response.state", "equals": "cancelled"}},

    {"op": "agentSignIn", "label": "wrong-method", "follow": false, "allowError": true,
     "request": {"provider": "openRouter", "method": "deviceCode"}},
    {"op": "expect", "request": {"step": "wrong-method", "errorCode": "badRequest"}},
    {"op": "agentSignIn", "label": "openrouter-key", "follow": false, "request": {"provider": "openRouter", "method": "apiKey"}},
    {"op": "agentAttach", "label": "openrouter-fields", "follow": false,
     "request": {"taskID": "${openrouter-key.response.taskID}", "afterSeq": 0, "waitMilliseconds": 5000}},
    {"op": "expect", "request": {"step": "openrouter-fields", "path": "response.events.0.kind", "equals": "input"}},
    {"op": "expect", "request": {"step": "openrouter-fields", "path": "response.events.0.payload.fields.1.key", "equals": "defaultModel"}},
    {"op": "agentSignInCancel", "request": {"taskID": "${openrouter-key.response.taskID}"}},
    {"op": "agentAttach", "label": "openrouter-key-ended", "follow": false,
     "request": {"taskID": "${openrouter-key.response.taskID}", "afterSeq": "${openrouter-fields.response.lastSeq}", "waitMilliseconds": 5000}},
    {"op": "expect", "request": {"step": "openrouter-key-ended", "path": "response.state", "equals": "cancelled"}},

    {"op": "agentSignIn", "label": "key", "follow": false, "request": {"provider": "anthropic"}},
    {"op": "agentAttach", "label": "fields", "follow": false,
     "request": {"taskID": "${key.response.taskID}", "afterSeq": 0, "waitMilliseconds": 5000}},
    {"op": "expect", "request": {"step": "fields", "path": "response.events.0.kind", "equals": "input"}},
    {"op": "expect", "request": {"step": "fields", "path": "response.events.0.payload.fields.0.key", "equals": "apiKey"}},
    {"op": "agentSignInRespond", "label": "empty-key", "allowError": true,
     "request": {"taskID": "${key.response.taskID}", "values": {"apiKey": ""}}},
    {"op": "expect", "request": {"step": "empty-key", "errorCode": "badRequest"}},
    {"op": "agentSignInCancel", "request": {"taskID": "${key.response.taskID}"}},
    {"op": "agentAttach", "label": "key-ended", "follow": false,
     "request": {"taskID": "${key.response.taskID}", "afterSeq": "${fields.response.lastSeq}", "waitMilliseconds": 5000}},
    {"op": "expect", "request": {"step": "key-ended", "path": "response.state", "equals": "cancelled"}},
    {"op": "agentSignInRespond", "label": "after-end", "allowError": true,
     "request": {"taskID": "${key.response.taskID}", "values": {"apiKey": "late"}}},
    {"op": "expect", "request": {"step": "after-end", "ok": false}},
    {"op": "agentAccountList", "label": "after"}
  ]
}
