{
  "name": "i2-git-remote",
  "steps": [
    {"op": "hello"},
    {"op": "gitAuthorSet", "request": {"authorName": "Apelin Console", "authorEmail": "console@apelin.invalid"}},
    {"op": "gitCredentialRemove", "request": {"host": "apelin.invalid"}, "label": "remove-absent"},
    {"op": "gitSettings", "request": {}, "label": "settings"},
    {"op": "expect", "request": {"step": "settings", "path": "response.authorName", "equals": "Apelin Console"}},
    {"op": "expect", "request": {"step": "settings", "path": "response.authorEmail", "equals": "console@apelin.invalid"}},
    {"op": "gitRepositoryCreate", "request": {"name": "not a name", "visibility": "private"}, "label": "create-refused", "allowError": true},
    {"op": "expect", "request": {"step": "create-refused", "errorCode": "badRequest"}},
    {"op": "gitIssueCreate", "request": {"repository": "no-owner", "title": "Refused before any sign-in is read", "body": "Nothing reaches GitHub."}, "label": "issue-refused", "allowError": true},
    {"op": "expect", "request": {"step": "issue-refused", "errorCode": "badRequest"}},
    {"op": "projectCreate", "request": {"templateID": "wiki.qaq.apelin.workspace/empty", "name": "I2GitImport", "values": {}}, "label": "workspace"},
    {"op": "gitCloneInto", "request": {"projectID": "${workspace.response.projectID}", "url": "https://github.com/libgit2/TestGitRepository.git", "branch": "first-merge"}, "label": "import", "timeoutSeconds": 300},
    {"op": "expect", "request": {"step": "import", "state": "succeeded"}},
    {"op": "gitStatus", "request": {"projectID": "${workspace.response.projectID}"}, "label": "status"},
    {"op": "expect", "request": {"step": "status", "path": "response.branch", "equals": "first-merge"}},
    {"op": "expect", "request": {"step": "status", "path": "response.head", "equals": "0966a434eb1a025db6b71485ab63a3bfbea520b6"}},
    {"op": "expect", "request": {"step": "status", "path": "response.entries", "equals": []}},
    {"op": "gitRemoteList", "request": {"projectID": "${workspace.response.projectID}"}, "label": "remotes"},
    {"op": "expect", "request": {"step": "remotes", "path": "response.remotes", "equals": [{"name": "origin", "url": "https://github.com/libgit2/TestGitRepository.git"}]}},
    {"op": "gitRemoteSet", "request": {"projectID": "${workspace.response.projectID}", "name": "mirror", "url": "https://user:token@example.com/mirror.git"}, "label": "remote-credential", "allowError": true},
    {"op": "expect", "request": {"step": "remote-credential", "errorCode": "badRequest"}},
    {"op": "gitRemoteSet", "request": {"projectID": "${workspace.response.projectID}", "name": "https://example.com/mirror.git", "url": "https://example.com/mirror.git"}, "label": "remote-address-name", "allowError": true},
    {"op": "expect", "request": {"step": "remote-address-name", "errorCode": "badRequest"}},
    {"op": "gitRemoteSet", "request": {"projectID": "${workspace.response.projectID}", "name": "mirror", "url": "https://example.com/mirror.git"}, "label": "remote-add"},
    {"op": "expect", "request": {"step": "remote-add", "path": "response.remote.url", "equals": "https://example.com/mirror.git"}},
    {"op": "gitPull", "request": {"projectID": "${workspace.response.projectID}", "remote": "https://example.com/mirror.git"}, "label": "pull-address", "allowError": true},
    {"op": "expect", "request": {"step": "pull-address", "errorCode": "badRequest"}},
    {"op": "gitRemoteRemove", "request": {"projectID": "${workspace.response.projectID}", "name": "mirror"}, "label": "remote-remove"},
    {"op": "gitRemoteRemove", "request": {"projectID": "${workspace.response.projectID}", "name": "mirror"}, "label": "remote-remove-again", "allowError": true},
    {"op": "expect", "request": {"step": "remote-remove-again", "errorCode": "notFound"}},
    {"op": "gitResetPreview", "request": {"projectID": "${workspace.response.projectID}", "remote": "origin", "branch": "first-merge"}, "label": "reset-preview", "timeoutSeconds": 300},
    {"op": "expect", "request": {"step": "reset-preview", "state": "succeeded"}},
    {"op": "expect", "request": {"step": "reset-preview", "path": "lastEvent.payload.result.upToDate", "equals": true}},
    {"op": "gitResetPreview", "request": {"projectID": "${workspace.response.projectID}", "remote": "https://example.com/mirror.git"}, "label": "reset-preview-address", "allowError": true},
    {"op": "expect", "request": {"step": "reset-preview-address", "errorCode": "badRequest"}},
    {"op": "gitResetToRemote", "request": {"projectID": "${workspace.response.projectID}", "remote": "mirror", "branch": "first-merge", "expectedRemoteCommit": "0966a434eb1a025db6b71485ab63a3bfbea520b6"}, "label": "reset-no-remote", "allowError": true},
    {"op": "expect", "request": {"step": "reset-no-remote", "errorCode": "notFound"}},
    {"op": "gitResetToRemote", "request": {"projectID": "${workspace.response.projectID}", "remote": "origin", "branch": "first-merge", "expectedRemoteCommit": "HEAD"}, "label": "reset-bad-commit", "allowError": true},
    {"op": "expect", "request": {"step": "reset-bad-commit", "errorCode": "badRequest"}},
    {"op": "gitResetToRemote", "request": {"projectID": "${workspace.response.projectID}", "remote": "origin", "branch": "first-merge", "expectedRemoteCommit": "0966a434eb1a025db6b71485ab63a3bfbea520b6", "expectedURL": "https://example.com/else.git"}, "label": "reset-elsewhere", "allowError": true},
    {"op": "expect", "request": {"step": "reset-elsewhere", "errorCode": "conflict"}},
    {"op": "gitFetch", "request": {"projectID": "${workspace.response.projectID}"}, "label": "fetch", "timeoutSeconds": 300},
    {"op": "expect", "request": {"step": "fetch", "state": "succeeded"}},
    {"op": "gitPull", "request": {"projectID": "${workspace.response.projectID}"}, "label": "pull", "timeoutSeconds": 300},
    {"op": "expect", "request": {"step": "pull", "state": "succeeded"}},
    {"op": "gitPush", "request": {"projectID": "${workspace.response.projectID}"}, "label": "push", "timeoutSeconds": 300, "allowError": true},
    {"op": "expect", "request": {"step": "push", "state": "failed"}},
    {"op": "expect", "request": {"step": "push", "path": "lastEvent.payload.reason", "equals": "authenticationRequired"}},
    {"op": "gitPush", "request": {"projectID": "${workspace.response.projectID}", "url": "https://github.com/libgit2/libgit2.git"}, "label": "push-elsewhere", "allowError": true},
    {"op": "expect", "request": {"step": "push-elsewhere", "errorCode": "conflict"}},
    {"op": "gitPush", "request": {"projectID": "${workspace.response.projectID}", "remote": "mirror", "url": "http://example.com/mirror.git"}, "label": "push-http", "allowError": true},
    {"op": "expect", "request": {"step": "push-http", "errorCode": "badRequest"}},
    {"op": "gitPush", "request": {"projectID": "${workspace.response.projectID}", "forceWithLease": {"expectedCommit": "0966a43"}}, "label": "lease-short", "allowError": true},
    {"op": "expect", "request": {"step": "lease-short", "errorCode": "badRequest"}},
    {"op": "gitPush", "request": {"projectID": "${workspace.response.projectID}", "forceWithLease": {"expectedCommit": "0966a434eb1a025db6b71485ab63a3bfbea520b6", "localCommit": "0000000000000000000000000000000000000001"}}, "label": "lease-moved", "allowError": true},
    {"op": "expect", "request": {"step": "lease-moved", "errorCode": "conflict"}},
    {"op": "gitCloneInto", "request": {"projectID": "${workspace.response.projectID}", "url": "https://github.com/libgit2/TestGitRepository.git"}, "label": "again", "allowError": true},
    {"op": "expect", "request": {"step": "again", "errorCode": "conflict"}}
  ]
}
